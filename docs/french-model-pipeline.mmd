    SPLIT --> FREQ["Poisson / NB frequency GLM"]
    SPLIT --> SEV["Gamma severity GLM"]
    FREQ --> TECH["Technical claims cost"]
    SEV --> TECH
    TECH --> SIM["Loading simulator"]
    FREQ --> DIAG["Calibration and diagnostics"]
    SEV --> DIAG
    SIM --> APP["Streamlit"]
    DIAG --> APP

